{
  "name": "ledgence-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/check-content.mjs && node scripts/licenses.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 5180",
    "build": "node scripts/check-content.mjs && node scripts/licenses.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 5180",
    "licenses": "node scripts/licenses.mjs",
    "check": "node scripts/check-content.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "@fontsource/inter": "5.3.0",
    "astro": "7.4.7"
  },
  "overrides": {
    "undici": "8.12.2",
    "zod": "4.6.7",
    "source-map-js": "1.2.2",
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "vite": "8.3.5",
    "postcss-nested@6.2.0": {
      "postcss-selector-parser": "7.1.6"
    },
    "@astrojs/mdx": "8.1.3",
    "rolldown": "1.2.16",
    "es-module-lexer": "3.0.4"
  }
}
